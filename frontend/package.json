{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "lint": "oxlint --deny-warnings",
    "lint:eslint": "eslint .",
    "dead-code": "knip --no-config-hints",
    "architecture": "dependency-cruise --config dependency-cruiser.config.mjs src e2e playwright.config.ts vite.config.ts",
    "habit-hooks": "habit-hooks --config ../.habit-hooks/frontend.toml",
    "openapi:generate": "openapi-ts",
    "quality": "npm run lint && npm run lint:eslint && npm run typecheck && npm run typecheck:e2e && npm run dead-code && npm run architecture",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.0.4",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "knip": "^6.32.2",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "ts-morph": "^28.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
