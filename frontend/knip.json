{
  "$schema": "./node_modules/knip/schema.json",
  "ignoreBinaries": ["habit-hooks"],
  "ignore": ["src/generated/**"],
  "ignoreExportsUsedInFile": true,
  "entry": [
    "src/main.tsx!",
    "src/**/*.test.ts",
    "vite.config.ts"
  ],
  "project": ["src/**/*.ts!", "src/**/*.tsx!", "e2e/**/*.ts", "playwright.config.ts", "vite.config.ts"],
  "ignoreDependencies": [
    "ts-morph"
  ]
}
